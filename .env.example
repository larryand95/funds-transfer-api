# ============================================
# Array Banking API - Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123
DB_NAME=arraybank_dev
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h

# ============================================
# JWT Configuration
# ============================================
# JWT keys are auto-generated in development if not provided
# For production, you MUST provide base64-encoded RSA keys
# JWT_PRIVATE_KEY=<base64-encoded-private-key>
# JWT_PUBLIC_KEY=<base64-encoded-public-key>
JWT_ISSUER=banking-api
JWT_ACCESS_TOKEN_DURATION=24h
JWT_REFRESH_TOKEN_DURATION=168h

# ============================================
# Security Configuration
# ============================================
BCRYPT_COST=12
RATE_LIMIT_PER_SECOND=5
MAX_FAILED_ATTEMPTS=3
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# NorthWind Bank Integration
# ============================================
# Required: Base URL and API Key from NorthWind
NORTHWIND_BASE_URL=https://api.northwindbank.com
NORTHWIND_API_KEY=your_northwind_api_key_here

# Optional: API Secret (only if NorthWind requires it)
# If NorthWind only provides an API key, leave this empty
NORTHWIND_API_SECRET=

# Optional: Timeout and retry configuration
NORTHWIND_TIMEOUT=30s
NORTHWIND_RETRY_ATTEMPTS=3
NORTHWIND_RETRY_DELAY=2s
NORTHWIND_ENABLE_AUTH=true

# ============================================
# Regulator Webhook Configuration
# ============================================
# Required: Webhook URL for regulator notifications
# Set to empty string to disable regulator notifications
REGULATOR_WEBHOOK_URL=

# Optional: Webhook secret for HMAC-SHA256 signature (if regulator requires it)
REGULATOR_WEBHOOK_SECRET=

# Optional: Timeout and retry configuration
REGULATOR_WEBHOOK_TIMEOUT=5s
REGULATOR_WEBHOOK_MAX_RETRIES=10
REGULATOR_WEBHOOK_ENABLE_SIGNING=false
REGULATOR_WEBHOOK_ENABLED=false

# ============================================
# Feature Flags
# ============================================
AUTO_MIGRATE=true
SEED_DATABASE=true
ENABLE_SWAGGER=true

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080