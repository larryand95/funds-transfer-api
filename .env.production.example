# ============================================
# Array Banking API - Production Environment
# ============================================
# Copy this file to .env.production and update with your production values
# cp .env.production.example .env.production
# 
# ⚠️  SECURITY WARNING: Never commit .env.production to version control
# ⚠️  Use secure secret management in production (HashiCorp Vault, AWS Secrets Manager, etc.)

# ============================================
# Application Configuration
# ============================================
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# ============================================
# Database Configuration
# ============================================
# ⚠️  Use strong passwords and secure connection in production
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USER=your_production_db_user
DB_PASSWORD=your_strong_production_password_here
DB_NAME=arraybank_prod
DB_SSLMODE=require
DB_MAX_CONNECTIONS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ============================================
# JWT Configuration
# ============================================
# ⚠️  REQUIRED in production: You MUST provide RSA keys
# Generate keys using:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then base64 encode them for these variables
JWT_PRIVATE_KEY=<base64-encoded-production-private-key>
JWT_PUBLIC_KEY=<base64-encoded-production-public-key>
JWT_ISSUER=banking-api
JWT_ACCESS_TOKEN_DURATION=1h
JWT_REFRESH_TOKEN_DURATION=24h

# ============================================
# Security Configuration
# ============================================
BCRYPT_COST=12
RATE_LIMIT_PER_SECOND=10
MAX_FAILED_ATTEMPTS=5
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# NorthWind Bank Integration
# ============================================
# Production NorthWind API credentials
NORTHWIND_BASE_URL=https://api.northwindbank.com
NORTHWIND_API_KEY=your_production_northwind_api_key

# Optional: API Secret (only if NorthWind requires it)
# If NorthWind only provides an API key, leave this empty
NORTHWIND_API_SECRET=

# Production timeout and retry configuration
NORTHWIND_TIMEOUT=30s
NORTHWIND_RETRY_ATTEMPTS=5
NORTHWIND_RETRY_DELAY=2s
NORTHWIND_ENABLE_AUTH=true

# ============================================
# Regulator Webhook Configuration
# ============================================
# ⚠️  REQUIRED in production: Regulator webhook URL for compliance
REGULATOR_WEBHOOK_URL=https://regulator.example.com/webhooks/transfers

# ⚠️  REQUIRED in production: Webhook secret for HMAC-SHA256 signature
# Use a strong, randomly generated secret
REGULATOR_WEBHOOK_SECRET=your_production_webhook_secret_here

# Production timeout and retry configuration
REGULATOR_WEBHOOK_TIMEOUT=5s
REGULATOR_WEBHOOK_MAX_RETRIES=10
REGULATOR_WEBHOOK_ENABLE_SIGNING=true
REGULATOR_WEBHOOK_ENABLED=true

# ============================================
# Feature Flags
# ============================================
AUTO_MIGRATE=true
SEED_DATABASE=false
ENABLE_SWAGGER=false

# ============================================
# CORS Configuration
# ============================================
# ⚠️  Set to your actual production domains
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_ORIGINS=https://yourdomain.com